<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Velomux.Desktop.MainWindow"
        Title="Velomux | Media Workstation"
        Width="1440" Height="830" MinWidth="1024" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#09111D" Foreground="#E9F1FC"
        FontFamily="Segoe UI">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#131F30"/>
      <Setter Property="BorderBrush" Value="#2B3C55"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#8879F2"/>
      <Setter Property="Foreground" Value="#0D1630"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#ADA3FF"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#21324A"/>
      <Setter Property="Foreground" Value="#E4EFFD"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#30435F"/>
    </Style>
    <Style Selector="Button.workflow">
      <Setter Property="Background" Value="#1C2A40"/>
      <Setter Property="Foreground" Value="#DCE8FC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="13,12"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style Selector="Button.workflow:pointerover">
      <Setter Property="Background" Value="#34345F"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#95ACCD"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
  </Window.Styles>

  <Grid x:Name="AppShell" ColumnDefinitions="218,*">
    <Border x:Name="NavSidebar" Grid.Column="0"
            Background="#101B2C" BorderBrush="#2A3B54"
            BorderThickness="0,0,1,0" Padding="16,24,16,16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Spacing="9">
          <Border Height="1" Background="#35445B"/>
          <TextBlock Text="PROJECT CREATOR &amp; LEAD MAINTAINER"
                     Classes="label" TextWrapping="Wrap" FontSize="10"/>
          <TextBlock Text="Adam Knight" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="@admknight" Foreground="#91A8C8" FontSize="11"/>
          <TextBlock Text="VeloFlow · Native Avalonia" Foreground="#8CA7C7" FontSize="11"/>
        </StackPanel>
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="45" Height="45" CornerRadius="12" Background="#33315E">
              <TextBlock Text="V" Foreground="#80E6CF" FontSize="26"
                         FontWeight="Bold" HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="VELOMUX" FontSize="18" FontWeight="Bold"
                         Foreground="#EFEAFF"/>
              <TextBlock Text="MEDIA WORKSTATION" FontSize="9"
                         Foreground="#9BB0CF"/>
            </StackPanel>
          </StackPanel>
          <Border Height="1" Background="#35445B" Margin="0,10"/>
          <TextBlock Text="VELOFLOW WORKFLOWS" Classes="label"/>
          <Button Content="▣  Video" Tag="video" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="♫  Audio" Tag="audio" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="▤  Images" Tag="images" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="↗  Extract audio" Tag="extract" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="⇣  Compress" Tag="compress" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="◇  Rewrap" Tag="rewrap" Classes="workflow" Click="ChooseTask_Click"/>
          <Button Content="✂  Trim" Tag="trim" Classes="workflow" Click="ChooseTask_Click"/>
          <Border Height="1" Background="#35445B" Margin="0,12"/>
          <TextBlock Text="OFFLINE-FIRST · LOCAL PROCESSING"
                     TextWrapping="Wrap" Foreground="#7E94B5" FontSize="10"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="20,18,20,18" RowDefinitions="Auto,*" RowSpacing="15">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Your media. Your format." FontSize="25" FontWeight="Bold"/>
          <TextBlock Text="Choose a task, inspect your queue, and create verified outputs."
                     FontSize="12" Foreground="#A9BBD2"/>
          <TextBlock x:Name="CompactCreator"
                     Text="Adam Knight · Project Creator &amp; Lead Maintainer"
                     FontSize="10" Foreground="#ABA1FF" IsVisible="False"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#173832" Padding="12,8"
                CornerRadius="10" VerticalAlignment="Top">
          <TextBlock Text="●  ON DEVICE" FontSize="10"
                     Foreground="#82E5CC" FontWeight="SemiBold"/>
        </Border>
      </Grid>

      <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
        <WrapPanel x:Name="CompactTaskBar" Grid.Row="0" IsVisible="False"
                   Orientation="Horizontal">
          <Button Content="Video" Tag="video" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Audio" Tag="audio" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Images" Tag="images" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Extract audio" Tag="extract" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Compress" Tag="compress" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Rewrap" Tag="rewrap" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
          <Button Content="Trim" Tag="trim" Classes="workflow" Margin="0,0,6,5" Click="ChooseTask_Click"/>
        </WrapPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,410" ColumnSpacing="14">
          <Border x:Name="QueuePanel" Grid.Column="0" Classes="card" Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
              <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="Conversion queue" FontSize="19" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding Queued, StringFormat='In queue  {0}'}"
                             Foreground="#B3A6FF" FontSize="12"/>
                  <TextBlock Text="{Binding Completed, StringFormat='Completed  {0}'}"
                             Foreground="#7BE4C6" FontSize="12"/>
                  <TextBlock Text="{Binding Failed, StringFormat='Failed  {0}'}"
                             Foreground="#F4A3B5" FontSize="12"/>
                </StackPanel>
              </StackPanel>

              <WrapPanel Grid.Row="1">
                <Button Content="+ Add files" Classes="primary" Margin="0,0,6,4"
                        IsEnabled="{Binding CanAddFiles}" Click="AddFiles_Click"/>
                <Button Content="Add folder" Classes="secondary" Margin="0,0,6,4"
                        IsEnabled="{Binding CanAddFiles}" Click="AddFolder_Click"/>
                <Button Content="Remove" Classes="secondary" Margin="0,0,6,4"
                        IsEnabled="{Binding CanRemoveSelected}" Click="RemoveSelected_Click"/>
                <Button Content="Clear completed" Classes="secondary" Margin="0,0,0,4"
                        IsEnabled="{Binding CanAddFiles}" Click="ClearCompleted_Click"/>
              </WrapPanel>

              <Border Grid.Row="2" Background="#0B1727" CornerRadius="10"
                      BorderBrush="#2C4059" BorderThickness="1"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Media_DragOver"
                      DragDrop.Drop="Media_Drop">
                <Grid>
                  <Grid x:Name="QueueDataPanel" IsVisible="{Binding HasQueue}"
                        RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,100" Margin="12,10">
                      <TextBlock Text="SOURCE FILE" Classes="label"/>
                      <TextBlock Grid.Column="1" Text="STATUS" Classes="label"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}"
                             SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="7,7" Spacing="5">
                            <Grid ColumnDefinitions="*,100">
                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" FontSize="12"/>
                              <TextBlock Grid.Column="1" Text="{Binding Status}"
                                         Foreground="#B1C5F0" FontSize="11"/>
                            </Grid>
                            <TextBlock Text="{Binding Detail}" Foreground="#92A7C4"
                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Height="3" Value="{Binding Progress}"
                                         Minimum="0" Maximum="100"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                  <StackPanel x:Name="EmptyQueuePanel"
                              IsVisible="{Binding IsQueueEmpty}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Spacing="10" Margin="20" MaxWidth="430">
                    <Border Width="64" Height="64" Background="#31315E"
                            CornerRadius="17" HorizontalAlignment="Center">
                      <TextBlock Text="↓" FontSize="30" Foreground="#B1A7FF"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drop media here" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag video, audio or image files here, or use Add files / Add folder."
                               Foreground="#9DB1D0" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="12"/>
                    <Button Content="Choose files" Classes="secondary"
                            HorizontalAlignment="Center" Click="AddFiles_Click"/>
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel Grid.Row="3" Spacing="7">
                <WrapPanel>
                  <Button Content="Inspect selected" Classes="secondary"
                          Margin="0,0,7,0" IsEnabled="{Binding CanRemoveSelected}"
                          Click="Inspect_Click"/>
                  <TextBlock Text="Input files are never changed."
                             FontSize="10" Foreground="#91A8C6"
                             VerticalAlignment="Center"/>
                </WrapPanel>
                <Border Background="#14263C" CornerRadius="9" Padding="10,8">
                  <TextBlock Text="{Binding MediaInfo}" MaxLines="4"
                             TextWrapping="Wrap" FontSize="11" Foreground="#BED0E8"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Row="4" Spacing="6">
                <TextBlock Text="ACTIVITY" Classes="label"/>
                <ListBox Height="90" ItemsSource="{Binding Activity}"
                         Background="#0C1829" BorderThickness="0"
                         CornerRadius="8" FontSize="10" Foreground="#AFC5DD"/>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#BBCCEA"
                           TextWrapping="Wrap" MaxLines="3"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border x:Name="SettingsPanel" Grid.Column="1" Classes="card">
            <ScrollViewer x:Name="SettingsViewport" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="18" Spacing="13">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding TaskTitle}" FontSize="19" FontWeight="Bold"/>
                  <TextBlock Text="{Binding TaskTagline}" Foreground="#A3B9D6"
                             FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TaskWarning}" Foreground="#E4BC80"
                             FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="Quick · Purpose"
                          Classes="secondary" Click="QuickMode_Click"/>
                  <Button Grid.Column="1" Content="Advanced · 51 presets"
                          Classes="secondary" Click="AdvancedMode_Click"/>
                </Grid>
                <Border Height="1" Background="#32435A"/>

                <StackPanel IsVisible="{Binding QuickMode}" Spacing="10">
                  <TextBlock Text="PURPOSE PROFILE" Classes="label"/>
                  <ComboBox ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                            MinHeight="38" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding ProfileDetail}" TextWrapping="Wrap"
                             Foreground="#A7BBD5" FontSize="11"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding AdvancedMode}" Spacing="9">
                  <TextBlock Text="ENCODER PRESETS" Classes="label"/>
                  <ComboBox ItemsSource="{Binding PresetFamilies}"
                            SelectedItem="{Binding PresetFamily, Mode=TwoWay}"
                            MinHeight="36"/>
                  <TextBox Text="{Binding PresetSearch, Mode=TwoWay}"
                           Watermark="Search 51 available presets"/>
                  <ComboBox ItemsSource="{Binding VisiblePresets}"
                            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                            MinHeight="38">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Border Background="#1C2C45" Padding="11,9" CornerRadius="8">
                  <TextBlock Text="{Binding SelectedPresetName}"
                             FontSize="12" TextWrapping="Wrap" Foreground="#C3B8FF"/>
                </Border>

                <TextBlock Text="SAVE OUTPUTS TO" Classes="label"/>
                <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}"
                         Watermark="Choose an output folder" FontSize="12"/>
                <Button Content="Browse destination..." Classes="secondary"
                        HorizontalAlignment="Left" Click="ChooseFolder_Click"/>
                <CheckBox Content="Preserve source folder hierarchy"
                          IsChecked="{Binding PreserveFolders, Mode=TwoWay}" FontSize="11"/>

                <Border Height="1" Background="#32435A"/>
                <TextBlock Text="EXISTING OUTPUT" Classes="label"/>
                <ComboBox ItemsSource="{Binding CollisionChoices}"
                          SelectedItem="{Binding Collision, Mode=TwoWay}"
                          MinHeight="36"/>
                <TextBlock Text="Rename is the safest default: existing files are never replaced."
                           Foreground="#91A7C5" FontSize="10" TextWrapping="Wrap"/>

                <Expander Header="Conversion settings" IsExpanded="False">
                  <StackPanel Margin="4,10,4,6" Spacing="8">
                    <TextBlock Text="Video quality (CRF)" Classes="label"/>
                    <TextBox Text="{Binding Quality, Mode=TwoWay}" Watermark="23"/>
                    <TextBlock Text="Image quality (0 = preset, 1–100 override)" Classes="label"/>
                    <TextBox Text="{Binding ImageQuality, Mode=TwoWay}" Watermark="0"/>
                    <TextBlock Text="Trim start (seconds)" Classes="label"/>
                    <TextBox Text="{Binding TrimStart, Mode=TwoWay}" Watermark="0"/>
                    <TextBlock Text="Trim end (seconds; 0 = source end)" Classes="label"/>
                    <TextBox Text="{Binding TrimEnd, Mode=TwoWay}" Watermark="0"/>
                    <TextBlock Text="Playback speed" Classes="label"/>
                    <TextBox Text="{Binding Speed, Mode=TwoWay}" Watermark="1"/>
                    <CheckBox Content="Normalize audio volume"
                              IsChecked="{Binding Normalize, Mode=TwoWay}" FontSize="11"/>
                    <CheckBox Content="Full decode output verification (slower)"
                              IsChecked="{Binding FullDecode, Mode=TwoWay}" FontSize="11"/>
                  </StackPanel>
                </Expander>

                <Border Height="1" Background="#32435A"/>
                <Button Content="Start conversion" Classes="primary"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding CanStart}"
                        Click="Convert_Click"/>
                <Button Content="Cancel active batch" Classes="secondary"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding CanCancel}"
                        Click="Cancel_Click"/>
                <TextBlock Text="FFmpeg output is staged and validated before the engine publishes it."
                           TextWrapping="Wrap" Foreground="#8EA5C2" FontSize="10"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>